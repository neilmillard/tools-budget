NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GTM_ID=g-xxxxxxxxxxxxx

# Used by functions/api/contact.ts (Cloudflare Pages Function) to send the
# contact form email, and by scripts/send-newsletter.mjs in the weekly
# GitHub Actions publish run.
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_LIST_ID=12345

# Stripe key for the guide checkout flow (Cloudflare Pages Function). A
# restricted key (rk_test_.../rk_live_...) works as a drop-in replacement
# for a secret key and is the recommended type to use here.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx